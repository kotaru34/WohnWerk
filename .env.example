WOHNWERK_ENV=development
WOHNWERK_HOST=0.0.0.0
WOHNWERK_PORT=8000

# Existing PostgreSQL instance. PostGIS must be installed and enabled in this database.
WOHNWERK_DATABASE_URL=postgresql+psycopg://wohnwerk:change-me@postgres:5432/wohnwerk

# Optional internal AI service hosted in the GPU VM.
WOHNWERK_AI_ENABLED=false
WOHNWERK_AI_BASE_URL=http://ai-vm:8001
WOHNWERK_AI_TIMEOUT_SECONDS=120

# Austria is the only supported market during the initial implementation.
WOHNWERK_COUNTRY_CODE=AT
