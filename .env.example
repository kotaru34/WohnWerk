WOHNWERK_ENV=development
WOHNWERK_HOST=0.0.0.0
WOHNWERK_PORT=8000

# Existing PostgreSQL instance. PostGIS must be installed and enabled in this database.
WOHNWERK_DATABASE_URL=postgresql+psycopg://wohnwerk:change-me@postgres:5432/wohnwerk

# Optional internal AI service hosted in the GPU VM.
WOHNWERK_AI_ENABLED=false
WOHNWERK_AI_BASE_URL=http://ai-vm:8001
WOHNWERK_AI_TIMEOUT_SECONDS=120

# Optional local OSRM road router. Luftlinie/PostGIS remains the fallback and prefilter.
WOHNWERK_ROUTING_ENABLED=false
WOHNWERK_ROUTING_BASE_URL=http://127.0.0.1:5000
WOHNWERK_ROUTING_TIMEOUT_SECONDS=3
WOHNWERK_ROUTING_MAX_TABLE_COORDINATES=100
# Only set DE after the OSRM server is verified to load the Germany graph.
WOHNWERK_ROUTING_GRAPH_COUNTRIES=
WOHNWERK_ROUTING_MAX_SNAP_DISTANCE_METRES=3000
WOHNWERK_ROUTING_PREFILTER_PROPERTIES_PER_JOB=75

# Shared Playwright browser cache for the Immowelt DE adapter. Keep this outside /root so the
# www-data refresh service can execute the same browser revision installed by the operator.
PLAYWRIGHT_BROWSERS_PATH=/var/cache/wohnwerk-playwright

# Current market is Germany only.
WOHNWERK_COUNTRY_CODE=DE
